// Cloudflare Workers config: serve this repo as a static website.
// "name" must match the Worker name shown in your Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-website",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  // Custom domains: the domain must be in the same Cloudflare account.
  "routes": [
    { "pattern": "healthcaretracks.com", "custom_domain": true },
    { "pattern": "www.healthcaretracks.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
